"UnlitGeneric"
{
	"$translucent" 1
	"$baseTexture" "hud\greybg"

	// give it a slight outer soft edge
	$softedges 0
	$edgesoftnessstart 0.5
    	$edgesoftnessend 0.4
	$scaleedgesoftnessbasedonscreenres 1

	// give it a white outline
	$outline 0

	// and a drop shadow
	$glow 0
	$alpha 0.5

//	"$vertexcolor" 1
	$distancealpha 1
	"$no_fullbright" 1
	"$ignorez" 0
	"%keywords" "tf"
}
