$Macro OUTBINNAME "p4ss"

$Conditional "MOD_LAUNCHER" "1"

$Include "launcher_main.vpc"

$Macro MOD_APPID "3554290" [!$PLAYTEST] // Replace with your appid if you ship on Steam.
$Macro MOD_APPID "3655900" [$PLAYTEST]

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions	"$BASE;MOD_APPID=$MOD_APPID" 
	}
}

$Project "Launcher Main (Mod TF)"
{
    $Folder "Resource Files" [$WINDOWS]
    {
        $File   "launcher_main_mod_tf.rc"
        $File   "res\p4ss.ico"
    }
}