/// buildinfo.vpc
/// Purpose: Dynamically generate a string at build time corresponding to 
/// build properties and details.

$Macro SRCDIR		".."
$include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

$Project "Build Info"
{
    $Folder "Public Header Files"
    {
        $DynamicFile "$SRCDIR\public\buildinfo\buildinfo.h"
    }

    $Folder "Codegen"
    {
		$File "$SRCDIR\devtools\genbuildinfo.py"
        {
            $Configuration
            {
                $CustomBuildStep
                {
                    $Description        "Creating buildinfo..."
                    $CommandLine        "python $SRCDIR/devtools/genbuildinfo.py > $SRCDIR/buildinfo/buildinfo.gen.cpp"
                    $Outputs            "$SRCDIR\buildinfo\buildinfo.gen.cpp"
                }               
            }
        }

        $DynamicFile "$SRCDIR\buildinfo\buildinfo.gen.cpp"
        {
            $Configuration
            {
                $Compiler
                {
                    $Create/UsePrecompiledHeader    "Not Using Precompiled Headers" [$WINDOWS]
                }
            }
        }
    }
}

