# Ignore frequently changing NextBot debug logs
game/mod_tf/nbdebuglogs/**/*.debug.txt
game/mod_tf/nbdebuglogs/*.debug.txt
game/mod_tf/nextbot.debug.txt

# Keep documentation and placeholders in nbdebuglogs (not needed for above patterns, but explicit)
!game/mod_tf/nbdebuglogs/legend.md
!game/mod_tf/nbdebuglogs/notes.txt
!game/mod_tf/nbdebuglogs/bot-visuals-debug/.keep

# Source SDK / build outputs
# - Keep these succinct; Visual Studio and general tool junk is handled below.

# Valve VPC outputs and caches
__vpc__/
_vpc_/
*.vpc.sentinel
*.vpc_crc
*.vpc_cache

# Platform build artifacts (libraries/binaries)
client.pdb
client.dll
client.lib
server.pdb
server.dll
server.lib
client.so
client.so.dbg
server.so
server.so.dbg
server_srv.so
server_srv.so.dbg
client.dylib
client.dylib.dSYM/
server.dylib
server.dylib.dSYM/

# Obj trees and common build directories
obj*/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
Release_*/
Debug_*/
Release/x64/*
Debug/x64/*
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Generated proto headers/sources and other generated headers
generated_proto_*
*.pb.cc
*.pb.hh
*_nut.h # vscript autogen file

# Project files (non-source) and makefiles per platform
*.mak
*.mak.vpc_crc
*.xcodeproj/
!devtools/*.mak
!utils/smdlexp/smdlexp.mak

# Shader/temp and GCH
*.tmp
*.h.gch
*.h.gch.d

# Mod runtime config
config.cfg

# Misc generated/ephemeral
*.FileListAbsolute.txt
evntprov.h
*.recipe
